# Copy to a local .env file, or set the same names in the Netlify site
# environment. Do not put real values in this file. .env files are gitignored.

# Supabase project URL. This is the same public URL the CRM already uses.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon key (the public client key, not the service-role key).
# Netlify functions use it only to check that the caller is signed in.
SUPABASE_ANON_KEY=your-anon-key

# Shared secret for Hickory Street Finance loan sync and note-buyer invites.
# Generate a new value. The previous value was committed in this public repo
# and must be replaced in Netlify AND on the Hickory Street Finance server.
# At least 16 characters. The browser never sees this.
HSF_CRM_SYNC_SECRET=replace-with-a-new-long-random-value

# Optional. Must stay on hickorystreetfinance.com. Defaults to that host.
HSF_API_BASE=https://hickorystreetfinance.com

# Deed PDF extraction (already read by the Netlify functions).
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODELS=claude-sonnet-5,claude-opus-4-8

# Daily model-health email. If these are unset, the check still runs and logs.
RESEND_API_KEY=your-resend-key
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=LandFlow <alerts@example.com>
